{
  "name": "favbase-cli",
  "version": "0.1.0",
  "description": "Local CLI and daemon that let AI agents (Claude Code, Codex) search the favbase browser extension through an Agent Skill",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvisibleQAQ/favbase.git",
    "directory": "packages/favbase-cli"
  },
  "type": "module",
  "bin": {
    "favbase": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "compile": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
