# favbase — 环境变量样板。`cp .env.example .env.local` 后填写，`.env.local` 已 gitignore。
# 本文件被 git 跟踪，**不得写入任何真实密钥**：只有键名、数值默认与注释。
# 全部键在构建期由 Vite 内联（`import.meta.env`），改动后需重跑 `pnpm dev`。
# 注释掉的行 = 保持代码默认值；取消注释即覆盖。

# =============================================================
# LLM（AI 总结 / 标签 / Chat 共用；设置页填写的值优先于此处）
# =============================================================
# 活动 provider id，取值见 lib/providers.ts 的 LLM_PROVIDER_IDS
# VITE_LLM_PROVIDER=deepseek
# API key 按 provider id 拼键名：VITE_<PROVIDER_ID 大写>_API_KEY（lib/storage/resolve.ts）
# VITE_DEEPSEEK_API_KEY=
# VITE_DEEPSEEK_MODEL=
# 覆盖 provider 默认 baseUrl / 协议（custom provider 用）
# VITE_LLM_BASE_URL=
# VITE_LLM_PROTOCOL=

# =============================================================
# ASR（B站视频转录兜底；无官方字幕时走这里）
# =============================================================
# 活动 provider id，取值见 lib/providers.ts 的 ASR_PROVIDER_IDS
# VITE_ASR_PROVIDER=groq
# VITE_GROQ_API_KEY=

# =============================================================
# Embedding（语义检索）
# 优先级：设置页用户填写 > env（仅对 VITE_EMBEDDING_PROVIDER 指定的 provider）> provider 默认
# =============================================================
# VITE_EMBEDDING_PROVIDER=
# VITE_EMBEDDING_API_KEY=
# VITE_EMBEDDING_MODEL=
# VITE_EMBEDDING_BASE_URL=

# =============================================================
# HTTP — 全平台远程请求统一 deadline（秒，默认 30；lib/http/fetch-with-deadline.ts）
# =============================================================
# VITE_HTTP_DEADLINE_SECONDS=30

# =============================================================
# Agent Bridge — loopback 端口（默认 17836；必须为 1..65535）
# =============================================================
# VITE_AGENT_BRIDGE_PORT=17836

# =============================================================
# 平台数值策略参数（lib/env.ts envNumber；全部可选，默认值在各平台 TS 常量原位）
# 规则：有限非负数才覆盖（0 合法），缺省/非法静默回退默认
# 守卫：tests/platform-env-constants-guard.test.ts 锁定 key <-> 调用点 <-> 本文档三方同步
# =============================================================

# --- bilibili ---
# 收藏夹分页最小间隔（毫秒，默认 7000）。调小有 412 风控风险（07-24 事故后调参）
# VITE_BILIBILI_PAGE_DELAY_MIN_MS=7000
# 收藏夹分页间隔抖动上限（毫秒，默认 3000）；实际间隔 = MIN + rand(0, JITTER)
# VITE_BILIBILI_PAGE_DELAY_JITTER_MS=3000
# fav resource API 每页条数（默认 20，端点约定；是否硬上限未证实，调大自担风险）
# VITE_BILIBILI_PAGE_SIZE=20

# --- github ---
# Stars 分页每页条数（默认 100 = REST API 上限）
# VITE_GITHUB_PER_PAGE=100
# Stars 页间礼貌延迟（毫秒，默认 100；GitHub 对认证请求宽容）
# VITE_GITHUB_PAGE_DELAY_MS=100
# README 串行抓取间隔（毫秒，默认 100，与 PAGE_DELAY_MS 对齐）
# VITE_GITHUB_README_DELAY_MS=100
# README 入库截头上限（字符，默认 100000；防病态 README 打爆 embedding 成本）
# VITE_GITHUB_MAX_README_CHARS=100000

# --- bookmarks ---
# 提取队列每批条数（默认 50；每批一次 SELECT，与 UI 读交错）
# VITE_BOOKMARKS_BATCH_SIZE=50
# 逐书签网页抓取间隔（毫秒，默认 1000；politeness / anti-ban）
# VITE_BOOKMARKS_DEFAULT_DELAY_MS=1000
# 抓取网页体积上限（字节，默认 5242880 = 5 MiB）
# VITE_BOOKMARKS_MAX_HTML_BYTES=5242880
# charset 探测预扫窗口（字节，默认 1024）
# VITE_BOOKMARKS_META_PRESCAN_BYTES=1024
# 「有真实正文」判定阈值（trimmed Markdown 字符数，默认 200）
# VITE_BOOKMARKS_MIN_CONTENT_CHARS=200

# --- x (Twitter) ---
# 书签分页每页条数（默认 100，照抄 supermemory：更少请求 = 更低风控面）
# VITE_X_PAGE_SIZE=100
# 页间基础延迟（毫秒，默认 1000，supermemory 对标 + anti-detection research）
# VITE_X_BASE_DELAY_MS=1000
# 页间延迟抖动上限（毫秒，默认 500；模拟人类滚动节奏，也叠加进指数退避）
# VITE_X_JITTER_MS=500
# x-rate-limit-remaining 低于等于此值时主动暂停至 reset（默认 3）
# VITE_X_REMAINING_STOP_THRESHOLD=3
# 瞬态 429/5xx 重试上限（默认 5）
# VITE_X_MAX_RETRIES=5
# 指数退避基数（毫秒，默认 1000；延迟 = BASE * 2^attempt + jitter）
# VITE_X_BACKOFF_BASE_MS=1000
# x-rate-limit-reset 在过去（时钟偏移）时的兜底睡眠（毫秒，默认 1000）
# VITE_X_MIN_SLEEP_ON_RESET_MS=1000
# 卡片标题截断长度（字符，默认 140；全文在 platformMeta.text）
# VITE_X_TITLE_MAX_CHARS=140

# --- zhihu ---
# v4 items 每页条数（默认 20 = 端点约定）
# VITE_ZHIHU_ITEMS_PAGE_SIZE=20
# 页间基础延迟（毫秒，默认 1000；镜像 x，403 反爬真实存在——RSSHub 研究）
# VITE_ZHIHU_BASE_DELAY_MS=1000
# 页间延迟抖动上限（毫秒，默认 500）
# VITE_ZHIHU_JITTER_MS=500
# 瞬态 429/5xx 重试上限（默认 5；403 反爬不重试）
# VITE_ZHIHU_MAX_RETRIES=5
# 指数退避基数（毫秒，默认 1000）
# VITE_ZHIHU_BACKOFF_BASE_MS=1000
# 收藏夹列表失控翻页保险丝（页，默认 50）
# VITE_ZHIHU_MAX_COLLECTION_PAGES=50
# 单收藏夹条目失控翻页保险丝（页，默认 500）
# VITE_ZHIHU_MAX_ITEM_PAGES_PER_COLLECTION=500

# --- youtube ---
# Data API v3 每页条数（默认 50 = 端点上限）
# VITE_YOUTUBE_PAGE_SIZE=50
# 页间礼貌延迟（毫秒，默认 200；quota 充裕，纯礼貌非节流）
# VITE_YOUTUBE_PAGE_DELAY_MS=200
# platformMeta.description 卡片截断长度（字符，默认 500；全文在 item_contents）
# VITE_YOUTUBE_META_DESCRIPTION_MAX_CHARS=500
